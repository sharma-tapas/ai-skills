{"nodes": [{"id": "skill_tdd_tdd_workflow", "label": "TDD Workflow Skill", "file_type": "document", "source_file": "skills/tdd/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": "community"}, {"id": "skill_tdd_red_green_refactor", "label": "RED-GREEN-REFACTOR Cycle", "file_type": "rationale", "source_file": "skills/tdd/SKILL.md", "source_location": "Workflow section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The cycle enforces that a test is compiled and executed (not just written) before implementation starts (RED gate), and that tests pass before refactoring begins (GREEN gate), ensuring tests verify real behavior not imagined behavior."}, {"id": "skill_tdd_tracer_bullet", "label": "Tracer Bullet TDD Pattern", "file_type": "rationale", "source_file": "skills/tdd/SKILL.md", "source_location": "Tracer Bullet section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write one test that confirms one thing, proving the end-to-end path works before expanding coverage. Prevents horizontal slicing anti-pattern."}, {"id": "skill_tdd_horizontal_slicing_antipattern", "label": "Horizontal Slicing Anti-Pattern", "file_type": "rationale", "source_file": "skills/tdd/SKILL.md", "source_location": "Anti-Pattern section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writing all tests first then all implementation produces tests that verify imagined behavior, test data structure shapes rather than outcomes, and break on refactors that don't change anything the user sees."}, {"id": "skill_tdd_git_checkpoint", "label": "Git Checkpoint Commits at TDD Stages", "file_type": "rationale", "source_file": "skills/tdd/SKILL.md", "source_location": "Workflow section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One commit per confirmed RED, one per co