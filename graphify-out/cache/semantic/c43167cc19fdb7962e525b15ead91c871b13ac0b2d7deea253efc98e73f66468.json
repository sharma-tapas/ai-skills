{"nodes": [{"id": "claudemd_project_project_config", "label": "Project Configuration (claude.md/project.md)", "file_type": "document", "source_file": "claude.md/project.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claudemd_project_prometheus_metrics", "label": "Mandatory Prometheus Metrics Requirement", "file_type": "rationale", "source_file": "claude.md/project.md", "source_location": "Observability section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every gRPC method and REST endpoint must emit Prometheus metrics. No API or RPC ships without metrics. Go uses grpc.UnaryInterceptor; Python instruments at the entrypoint layer, never inside usecase or domain."}, {"id": "claudemd_project_grpc_gateway", "label": "gRPC + grpc-gateway Service Structure", "file_type": "rationale", "source_file": "claude.md/project.md", "source_location": "Repository Layout and Key Commands", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All REST is generated via grpc-gateway (hand-rolled HTTP handlers are forbidden). buf generate regenerates stubs from proto; generated files under gen/ must never be manually edited."}, {"id": "claudemd_project_ralph_loop_workflow", "label": "Ralph Loop Iterative Development Workflow", "file_type": "rationale", "source_file": "claude.md/project.md", "source_location": "Feature Development Workflow section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implementation does not start until the PRD exists in docs/prd/. Ralph loop prompts reference the PRD path as the source of truth for completion criteria."}], "edges": [{"source": "claudemd_project_ralph_loop_workflow", "target": "claudemd_global_ralph_loop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "claude.md/project.md", "source_loca