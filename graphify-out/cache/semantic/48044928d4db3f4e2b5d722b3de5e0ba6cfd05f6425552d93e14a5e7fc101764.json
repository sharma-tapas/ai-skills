{"nodes": [{"id": "readme_tapas_claude_toolkit", "label": "tapas-claude-toolkit Plugin", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_feature_development_workflow", "label": "Feature Development Workflow (Brainstorm \u2192 Grill \u2192 PRD)", "file_type": "rationale", "source_file": "README.md", "source_location": "Feature Development Workflow section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-step planning sequence (brainstorm \u2192 grill-me \u2192 to-prd) exists to catch design errors when they are cheap to fix, not after code is written. No implementation task starts without a PRD as the completion criteria source of truth."}, {"id": "readme_vertical_slice_principle", "label": "Vertical Slices Over Horizontal Layers Principle", "file_type": "rationale", "source_file": "README.md", "source_location": "Philosophy section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Features built as end-to-end tracer bullets (one test \u2192 one implementation \u2192 repeat) rather than all tests then all implementations, to keep feedback tight and tests grounded in reality rather than imagined behavior."}, {"id": "readme_behavior_over_implementation", "label": "Behavior Over Implementation Testing Principle", "file_type": "rationale", "source_file": "README.md", "source_location": "Philosophy section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests verify what the system does through public interfaces, not how it does it internally. Code can change; tests should not need to, making them resilient to refactors."}], "edges": [{"source": "readme_tapas_claude_toolkit", "target": "skill_tdd_tdd_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.m